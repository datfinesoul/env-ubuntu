#!/usr/bin/env bash
# shellcheck disable=SC1091
source "$(dirname "${0}")/_core.bash"

if [[ "$(uname -s)" == "Darwin" ]]; then
	>&2 echo 'No Darwin Install'
else

	# AppImage requires FUSE
	if ! dpkg -l libfuse2 &>/dev/null; then
		info "Installing libfuse2 (required for AppImage)"
		sudo apt-get install -y libfuse2
	fi

	### MODIFY: START
	repo='cjpais/Handy'
	pattern="${architecture}\.AppImage$"
	### MODIFY: END

	releases="$( \
		curl -s "https://api.github.com/repos/${repo}/releases/latest" \
		)"

	read -r version url <<< "$(
		printf "%s\n" "${releases}" \
		| jq \
		--arg pattern "$pattern" \
		-r '[.tag_name, (.assets[].browser_download_url | select(test($pattern)))] | @tsv'
	)"

	debug "version:${version}"
	debug "url:${url}"

	if [[ -z "${url}" ]]; then
		fail "unable to find match, displaying all files for debugging"
		printf "%s\n" "${releases}" \
			| jq -r '[.tag_name, (.assets[].browser_download_url)]'
		exit 1
	fi

	executable="$(echo "${repo##*/}" | tr '[:upper:]' '[:lower:]')"
	versioned_exe="${executable}_${version}"

	debug "executable:${executable}"
	debug "versioned_exe:${versioned_exe}"

	curl -L -o "$executable" "$url"
	chmod 755 "$executable"

	target_dir="${HOME}/.local/${executable}"
	bin_dir="${HOME}/.local/bin"

	mkdir -p "${target_dir}"
	mkdir -p "${bin_dir}"

	mv "${executable}" "${target_dir}/${versioned_exe}"

	# Extract icon from AppImage
	icon_dir="${HOME}/.local/share/icons"
	mkdir -p "${icon_dir}"
	icon_path="${icon_dir}/${executable}.png"

	# AppImages can be extracted with --appimage-extract
	# Extract to temp directory, find the icon, then clean up
	extract_dir=$(mktemp -d)
	pushd "${extract_dir}" > /dev/null
	"${target_dir}/${versioned_exe}" --appimage-extract > /dev/null 2>&1 || true
	# Look for icon in common locations within extracted AppImage
	if [[ -f "squashfs-root/.DirIcon" ]]; then
		cp "squashfs-root/.DirIcon" "${icon_path}"
	elif [[ -f "squashfs-root/handy.png" ]]; then
		cp "squashfs-root/handy.png" "${icon_path}"
	elif [[ -f "squashfs-root/usr/share/icons/hicolor/512x512/apps/handy.png" ]]; then
		cp "squashfs-root/usr/share/icons/hicolor/512x512/apps/handy.png" "${icon_path}"
	elif [[ -f "squashfs-root/usr/share/icons/hicolor/256x256/apps/handy.png" ]]; then
		cp "squashfs-root/usr/share/icons/hicolor/256x256/apps/handy.png" "${icon_path}"
	else
		# Find any png that might be the icon
		find squashfs-root -maxdepth 2 -name "*.png" -type f | head -1 | xargs -I{} cp {} "${icon_path}" 2>/dev/null || true
	fi
	popd > /dev/null
	rm -rf "${extract_dir}"

	debug "icon_path:${icon_path}"

	# AppImage stuff
	cat > "${bin_dir}/${executable}" <<-DOC
	#!/bin/bash
	export WEBKIT_DISABLE_DMABUF_RENDERER=1
	exec "${target_dir}/${versioned_exe}" "\$@"
	DOC
	chmod 755 "${bin_dir}/${executable}"

	# Create desktop entry
	cat > "$HOME/.local/share/applications/handy.desktop" <<-DOC
	[Desktop Entry]
	Name=Handy
	Comment=Speech to Text Application
	Exec=${bin_dir}/${executable}
	Icon=${icon_path}
	Terminal=false
	Type=Application
	Categories=Utility;System;
	StartupWMClass=Handy
	DOC

	update-desktop-database "$HOME/.local/share/applications"
	gtk-update-icon-cache -f -t "$HOME/.local/share/icons" 2>/dev/null || true
fi

# vim: set ft=bash :
